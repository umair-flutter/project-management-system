@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject UserManager<ApplicationUser> UserManager
@inject Project_Managemnet_System.Data.ApplicationDbContext Db
@{
    var isAdminPortal = string.Equals(ViewContext.RouteData.Values["area"] as string, "Admin", StringComparison.OrdinalIgnoreCase);
    var controller = ViewContext.RouteData.Values["controller"] as string;
    var action = ViewContext.RouteData.Values["action"] as string;
    var me = await UserManager.GetUserAsync(User);
    var myRole = me is null ? "" : (await UserManager.GetRolesAsync(me)).FirstOrDefault() ?? "";
    string Active(string c) => string.Equals(controller, c, StringComparison.OrdinalIgnoreCase) ? "active" : "";

    // Notification bell: unread count plus the latest few.
    var unread = 0;
    List<Notification> latest = [];
    if (me is not null)
    {
        unread = await Db.Notifications.CountAsync(n => n.UserId == me.Id && !n.IsRead);
        latest = await Db.Notifications.Where(n => n.UserId == me.Id).Include(n => n.Actor)
            .OrderByDescending(n => n.CreatedAt).Take(6).ToListAsync();
    }
    var here = Context.Request.Path + Context.Request.QueryString;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · ProjectDesk</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <aside class="pm-sidebar" id="pmSidebar">
        <a class="pm-brand text-decoration-none" asp-controller="Dashboard" asp-action="Index">
            <span class="pm-brand-mark"><i class="bi bi-kanban"></i></span> ProjectDesk
        </a>
        <div class="pm-portal-tag">@(isAdminPortal ? "Admin portal" : "Member portal")</div>
        <ul class="pm-nav">
            <li><a class="@Active("Dashboard")" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid-1x2"></i> Dashboard</a></li>
            <li><a class="@Active("MyTodos")" asp-controller="MyTodos" asp-action="Index"><i class="bi bi-person-check"></i> My to-dos</a></li>
            <li><a class="@(action != "Archived" ? Active("Projects") + Active("Todos") : "")" asp-controller="Projects" asp-action="Index"><i class="bi bi-folder2-open"></i> Projects</a></li>
            <li><a class="@Active("Calendar")" asp-controller="Calendar" asp-action="Index"><i class="bi bi-calendar3"></i> Calendar</a></li>
            <li><a class="@Active("Progress")" asp-controller="Progress" asp-action="Index"><i class="bi bi-activity"></i> Progress</a></li>
            <li><a class="@(action == "Archived" ? "active" : "")" asp-controller="Projects" asp-action="Archived"><i class="bi bi-archive"></i> Archived projects</a></li>
            @if (isAdminPortal)
            {
                <li><a class="@Active("Members")" asp-controller="Members" asp-action="Index"><i class="bi bi-people"></i> Members</a></li>
            }
            <li><a class="@(Active("Account"))" asp-controller="Account" asp-action="Profile"><i class="bi bi-person-circle"></i> My profile</a></li>
        </ul>
        <div class="pm-side-footer">
            @if (isAdminPortal)
            {
                <a asp-area="" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-box-arrow-up-right me-1"></i> Open member portal</a>
            }
            else if (User.CanCreateProjects())
            {
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-box-arrow-up-right me-1"></i> Open admin portal</a>
            }
        </div>
    </aside>

    <div class="pm-main">
        <header class="pm-topbar">
            <button class="btn btn-light pm-menu-btn" type="button" aria-label="Open menu" onclick="document.body.classList.toggle('pm-nav-open')">
                <i class="bi bi-list"></i>
            </button>
            <form method="get" asp-controller="Search" asp-action="Index" class="pm-search" role="search">
                <i class="bi bi-search"></i>
                <input type="search" name="q" class="form-control" placeholder="Search projects and to-dos" aria-label="Search projects and to-dos"
                       value="@(controller == "Search" ? Context.Request.Query["q"].ToString() : "")" />
            </form>
            <div class="ms-auto d-flex align-items-center gap-3">
                @if (me is not null)
                {
                    <div class="dropdown">
                        <button class="btn btn-light position-relative pm-bell" data-bs-toggle="dropdown" aria-expanded="false"
                                aria-label="@(unread > 0 ? $"{unread} unread notifications" : "Notifications")">
                            <i class="bi bi-bell"></i>
                            @if (unread > 0)
                            {
                                <span class="pm-bell-count">@(unread > 99 ? "99+" : unread.ToString())</span>
                            }
                        </button>
                        <div class="dropdown-menu dropdown-menu-end shadow pm-notify-menu p-0">
                            <div class="d-flex align-items-center justify-content-between px-3 py-2 border-bottom">
                                <strong>Notifications</strong>
                                @if (unread > 0)
                                {
                                    <form method="post" asp-controller="Notifications" asp-action="MarkAllRead">
                                        <input type="hidden" name="returnUrl" value="@here" />
                                        <button class="btn btn-link btn-sm p-0" type="submit">Mark all read</button>
                                    </form>
                                }
                            </div>
                            @if (latest.Count == 0)
                            {
                                <div class="text-muted small text-center py-4">You're all caught up.</div>
                            }
                            @foreach (var n in latest)
                            {
                                <a class="pm-notify-item @(n.IsRead ? "" : "unread")" asp-controller="Notifications" asp-action="Open" asp-route-id="@n.Id">
                                    <partial name="_Avatar" model="n.Actor" />
                                    <span class="flex-grow-1 min-w-0">
                                        <span class="d-block small text-body">@n.Message</span>
                                        <small class="text-muted">@n.CreatedAt.ToLocalTime().ToString("dd MMM, HH:mm")</small>
                                    </span>
                                </a>
                            }
                            <a class="d-block text-center small py-2 border-top" asp-controller="Notifications" asp-action="Index">See all notifications</a>
                        </div>
                    </div>
                    <div class="dropdown">
                        <button class="btn btn-link text-decoration-none d-flex align-items-center gap-2 p-0" data-bs-toggle="dropdown" aria-expanded="false">
                            <partial name="_Avatar" model="me" />
                            <span class="text-start d-none d-sm-block lh-sm">
                                <span class="d-block fw-semibold text-body">@me.FullName</span>
                                <small class="text-muted">@(myRole == Roles.SuperAdmin ? "Super Admin" : myRole)</small>
                            </span>
                            <i class="bi bi-chevron-down small text-muted"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                            <li><span class="dropdown-item-text small text-muted">@me.Email</span></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="bi bi-person-circle me-2"></i>My profile</a></li>
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword"><i class="bi bi-shield-lock me-2"></i>Change password</a></li>
                            <li>
                                <form method="post" asp-controller="Account" asp-action="Logout">
                                    <button class="dropdown-item" type="submit"><i class="bi bi-box-arrow-right me-2"></i>Sign out</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
            </div>
        </header>

        <main class="pm-content">
            <partial name="_Flash" />
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
