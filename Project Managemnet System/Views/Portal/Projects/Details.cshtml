@model ProjectDetailsVm
@{
    ViewData["Title"] = Model.Project.Name;
    var a = Model.Access;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    object Route(string filter) => new { id = Model.Project.Id, filter, priority = Model.Priority, q = Model.Query, mine = Model.MineOnly ? true : (bool?)null };
}
<partial name="_ProjectHeader" model="a" view-data='new ViewDataDictionary(ViewData) { { "Section", "todos" } }' />

<div class="pm-card">
    <nav class="pm-tabs" aria-label="To-do lists">
        @foreach (var (key, label) in TodoFilters.Tabs)
        {
            <a class="@(Model.Filter == key ? "active" : "")" href="@Url.Action("Details", Route(key))">@label<span class="count">@Model.Counts[key]</span></a>
        }
    </nav>

    <div class="d-flex flex-wrap gap-2 align-items-center p-3 border-bottom">
        <form method="get" class="d-flex flex-wrap gap-2 align-items-center flex-grow-1">
            <input type="hidden" name="filter" value="@Model.Filter" />
            <select name="priority" class="form-select" style="width:auto" onchange="this.form.submit()" aria-label="Priority">
                <option value="">All priorities</option>
                @foreach (var pr in new[] { TodoPriority.High, TodoPriority.Medium, TodoPriority.Low })
                {
                    <option value="@pr" selected="@(Model.Priority == pr)">@pr priority</option>
                }
            </select>
            <input name="q" value="@Model.Query" class="form-control" style="max-width:260px" placeholder="Search to-dos" aria-label="Search to-dos" />
            <div class="form-check ms-1">
                <input class="form-check-input" type="checkbox" name="mine" value="true" id="mine" checked="@Model.MineOnly" onchange="this.form.submit()" />
                <label class="form-check-label" for="mine">Assigned to me</label>
            </div>
            @if (Model.Priority is not null || !string.IsNullOrEmpty(Model.Query) || Model.MineOnly)
            {
                <a class="small" href="@Url.Action("Details", new { id = Model.Project.Id, filter = Model.Filter })">Clear filters</a>
            }
        </form>
        <a class="btn btn-light" asp-action="Export" asp-route-id="@Model.Project.Id" title="Download all to-dos as a CSV file for Excel"><i class="bi bi-download me-1"></i>Export</a>
        @if (a.CanManage && !Model.Project.IsArchived)
        {
            <div class="d-flex gap-2">
                <a class="btn btn-primary" asp-controller="Todos" asp-action="Create" asp-route-projectId="@Model.Project.Id"><i class="bi bi-plus-lg me-1"></i>Add task</a>
                <a class="btn btn-outline-danger" asp-controller="Todos" asp-action="Create" asp-route-projectId="@Model.Project.Id" asp-route-type="@TodoType.Bug"><i class="bi bi-bug me-1"></i>Report bug</a>
            </div>
        }
    </div>

    @if (Model.Todos.Count == 0)
    {
        <div class="pm-empty"><i class="bi bi-inbox"></i>No to-dos in this list.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table pm-table">
                <thead>
                    <tr><th>To-do</th><th>Type</th><th>Priority</th><th>Assigned to</th><th>Due</th><th>Status</th><th class="text-end"><span class="visually-hidden">Actions</span></th></tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.Todos)
                    {
                        <tr>
                            <td style="min-width:240px">
                                <a class="pm-todo-title @(t.Status != TodoStatus.Incomplete ? "done" : "")" asp-controller="Todos" asp-action="Details" asp-route-id="@t.Id">@t.Title</a>
                                @if (t.Comments.Count > 0)
                                {
                                    <span class="text-muted small ms-2" title="Comments"><i class="bi bi-chat-left-text"></i> @t.Comments.Count</span>
                                }
                            </td>
                            <td><span class="badge @Ui.TypeBadge(t.Type)"><i class="bi @Ui.TypeIcon(t.Type) me-1"></i>@t.Type</span></td>
                            <td><span class="badge @Ui.PriorityBadge(t.Priority)">@t.Priority</span></td>
                            <td class="text-nowrap">
                                <span class="d-inline-flex align-items-center gap-2">
                                    <partial name="_Avatar" model="t.Assignee" />
                                    <span class="@(t.Assignee is null ? "text-muted" : "")">@(t.Assignee?.FullName ?? "Unassigned")</span>
                                </span>
                            </td>
                            <td class="text-nowrap @(Ui.IsOverdue(t) ? "pm-overdue" : "")">@(t.DueDate?.ToString("dd MMM yyyy") ?? "—")</td>
                            <td><span class="badge @Ui.StatusBadge(t.Status)">@Ui.StatusLabel(t.Status)</span></td>
                            <td class="text-end text-nowrap">
                                <partial name="_StatusButtons" model="t" view-data='new ViewDataDictionary(ViewData) { { "Access", a }, { "ReturnUrl", returnUrl }, { "Compact", true } }' />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
