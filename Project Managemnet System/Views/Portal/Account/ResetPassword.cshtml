@model ResetPasswordVm
@{
    Layout = "/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = Model.Welcome ? "Set your password" : "Choose a new password";
}
<h2 class="fw-bold mb-1">@ViewData["Title"]</h2>
<p class="text-muted mb-4">For <strong>@Model.Email</strong>. Use at least 8 characters with upper and lower case letters, a number, and a symbol.</p>

<form method="post" asp-action="ResetPassword">
    <input type="hidden" asp-for="Email" />
    <input type="hidden" asp-for="Token" />
    <input type="hidden" asp-for="Welcome" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control form-control-lg" autocomplete="new-password" autofocus />
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>
    <div class="mb-4">
        <label asp-for="ConfirmPassword" class="form-label"></label>
        <input asp-for="ConfirmPassword" class="form-control form-control-lg" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
    </div>
    <button class="btn btn-primary btn-lg w-100" type="submit">@(Model.Welcome ? "Set password" : "Change password")</button>
</form>
<p class="text-center small mt-4 mb-0"><a asp-action="ForgotPassword">Link not working? Get a new one</a></p>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
