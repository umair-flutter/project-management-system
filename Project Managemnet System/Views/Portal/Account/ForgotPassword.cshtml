@model ForgotPasswordVm
@{
    Layout = "/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Forgot password";
    var sent = ViewBag.Sent as string;
}
@if (sent is not null)
{
    <div class="text-center">
        <div class="pm-stat-icon tint-indigo mx-auto mb-3"><i class="bi bi-envelope-check"></i></div>
        <h2 class="fw-bold mb-2">Check your email</h2>
        <p class="text-muted">If an account exists for <strong>@sent</strong>, we've sent a link to reset its password. It can take a minute to arrive; check your spam folder too.</p>
        <a class="btn btn-primary w-100 mt-2" asp-action="Login">Back to sign in</a>
    </div>
}
else
{
    <h2 class="fw-bold mb-1">Forgot your password?</h2>
    <p class="text-muted mb-4">Enter your account email and we'll send you a link to choose a new one.</p>
    <form method="post" asp-action="ForgotPassword">
        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control form-control-lg" autocomplete="username" autofocus />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <button class="btn btn-primary btn-lg w-100" type="submit">Send reset link</button>
    </form>
    <p class="text-center small mt-4 mb-0"><a asp-action="Login"><i class="bi bi-arrow-left"></i> Back to sign in</a></p>
}
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
