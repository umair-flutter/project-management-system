@model NotificationListVm
@{
    ViewData["Title"] = "Notifications";
    var anyUnread = Model.Items.Any(n => !n.IsRead);
}
<div class="d-flex flex-wrap align-items-end justify-content-between gap-3 mb-4">
    <div>
        <h1 class="pm-page-title">Notifications</h1>
        <p class="pm-page-sub">Assignments, comments, and status changes that involve you.</p>
    </div>
    @if (anyUnread)
    {
        <form method="post" asp-action="MarkAllRead">
            <button class="btn btn-outline-secondary" type="submit"><i class="bi bi-check2-all me-1"></i>Mark all as read</button>
        </form>
    }
</div>

<div class="pm-card" style="max-width:860px">
    @if (Model.Items.Count == 0)
    {
        <div class="pm-empty"><i class="bi bi-bell-slash"></i>No notifications yet.</div>
    }
    else
    {
        <div class="list-group list-group-flush rounded-3">
            @foreach (var n in Model.Items)
            {
                <a class="list-group-item list-group-item-action d-flex gap-3 align-items-start py-3 @(n.IsRead ? "" : "pm-unread-row")"
                   asp-action="Open" asp-route-id="@n.Id">
                    <partial name="_Avatar" model="n.Actor" />
                    <div class="flex-grow-1 min-w-0">
                        <div class="@(n.IsRead ? "" : "fw-semibold")">@n.Message</div>
                        <small class="text-muted">@n.Project?.Name · @n.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</small>
                    </div>
                    @if (!n.IsRead) { <span class="pm-unread-dot" title="Unread"></span> }
                </a>
            }
        </div>
    }
</div>
<div class="d-flex justify-content-between mt-3" style="max-width:860px">
    @if (Model.Page > 1) { <a class="btn btn-light btn-sm" asp-action="Index" asp-route-page="@(Model.Page - 1)"><i class="bi bi-arrow-left"></i> Newer</a> } else { <span></span> }
    @if (Model.HasMore) { <a class="btn btn-light btn-sm" asp-action="Index" asp-route-page="@(Model.Page + 1)">Older <i class="bi bi-arrow-right"></i></a> }
</div>
