@model List<MemberRowVm>
@{
    ViewData["Title"] = "Members";
    var canManageAll = ViewBag.CanManageAll is true;
    var role = ViewBag.Role as string;
}
<div class="d-flex flex-wrap align-items-end justify-content-between gap-3 mb-4">
    <div>
        <h1 class="pm-page-title">Members</h1>
        <p class="pm-page-sub">Accounts that can sign in to ProjectDesk.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-person-plus me-1"></i> Add member</a>
</div>

<div class="pm-card">
    <form method="get" class="d-flex flex-wrap gap-2 p-3 border-bottom">
        <input name="q" value="@ViewBag.Query" class="form-control" style="max-width:280px" placeholder="Search name or email" aria-label="Search members" />
        <select name="role" class="form-select" style="width:auto" onchange="this.form.submit()" aria-label="Role">
            <option value="">All roles</option>
            @foreach (var r in Roles.All)
            {
                <option value="@r" selected="@(role == r)">@(r == Roles.SuperAdmin ? "Super Admin" : r)</option>
            }
        </select>
    </form>
    @if (Model.Count == 0)
    {
        <div class="pm-empty"><i class="bi bi-person-x"></i>No members found.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table pm-table">
                <thead><tr><th>Name</th><th>Role</th><th>Projects</th><th>Open to-dos</th><th>Status</th><th>Joined</th><th></th></tr></thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <partial name="_Avatar" model="r.User" />
                                    <div><div class="fw-semibold">@r.User.FullName</div><small class="text-muted">@r.User.Email</small></div>
                                </div>
                            </td>
                            <td>
                                <span class="badge @(r.Role == Roles.SuperAdmin ? "badge-soft-danger" : r.Role == Roles.Admin ? "badge-soft-warning" : "badge-soft-info")">
                                    @(r.Role == Roles.SuperAdmin ? "Super Admin" : r.Role)
                                </span>
                            </td>
                            <td>@r.ProjectCount</td>
                            <td>@r.OpenTodos</td>
                            <td>
                                @if (r.User.IsActive) { <span class="badge badge-soft-success">Active</span> }
                                else { <span class="badge badge-soft-secondary">Inactive</span> }
                            </td>
                            <td class="text-nowrap">@r.User.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                            <td class="text-end">
                                @if (canManageAll || r.Role == Roles.Developer)
                                {
                                    <a class="btn btn-sm btn-light" asp-action="Edit" asp-route-id="@r.User.Id"><i class="bi bi-pencil"></i> Edit</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
